# ============================================================
# Ops Flash Report — Environment template
# Copy to `.env` at the repo root (or per-app) and fill in.
# NEVER commit the real `.env`.
# ============================================================

# ---- Supabase (Phase 1 / runtime) ----
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>            # safe to ship to browser (RLS-gated)
SUPABASE_SERVICE_ROLE_KEY=<service-role> # SERVER-SIDE ONLY — never in frontend
# Direct Postgres for ETL writes (session pooler, port 5432 — psycopg needs
# prepared statements, so do NOT use the 6543 transaction pooler here):
SUPABASE_DB_URL=postgresql://postgres.<ref>:<db-password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---- SQL Server DWH (legacy pyodbc path — kept for reference, unused) ----
DWH_SERVER=<host-or-ip>
DWH_DATABASE=DWH
DWH_USER=<read-only-user>
DWH_PASSWORD=<password>
DWH_DRIVER=ODBC Driver 18 for SQL Server

# ---- API Gateway (ERP read API used by the ETL; demo placeholder) ----
GATEWAY_URL=https://your-gateway.example.com/mcp
GATEWAY_TOKEN=<bearer-token>
GATEWAY_DEVICE_ID=<device-id>
GATEWAY_TIMEOUT=300

# ---- Google Sheets targets (ETL only) ----
SHEETS_SA_PATH=C:\path\to\service-account.json
SHEETS_SPREADSHEET_ID=<SBU_Performance_Tracker id>
SHEETS_RANGE=Target_Input

# ---- Partner feed demo source (ETL only; placeholder values) ----
PARTNER_FEED_BASE_URL=https://partner-portal.example.com
PARTNER_FEED_MOBILE=
PARTNER_FEED_PASSWORD=
PARTNER_FEED_TOKEN=                   # optional: reuse a live session token (dev)
PARTNER_FEED_BYPASS=                  # demo portal session key
PARTNER_FEED_ACCOUNT_ID=1
PARTNER_FEED_BRANCH_ID=1
PARTNER_FEED_USER_ID=1

# ---- ETL runtime ----
ETL_REPORT_DATE=                        # optional; default = today
ETL_ALERT_CHANNEL=email                 # email | teams | telegram
ETL_ALERT_RECIPIENTS=
ETL_SMTP_HOST=
ETL_SMTP_PORT=
ETL_SMTP_USER=
ETL_SMTP_PASSWORD=
ETL_TEAMS_WEBHOOK_URL=
